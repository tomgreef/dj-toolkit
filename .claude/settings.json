{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python tools/check.py *)",
      "Bash(.venv/Scripts/python tools/screenshots.py *)",
      "Bash(.venv/Scripts/python -m pytest *)",
      "Bash(.venv/Scripts/ruff check *)",
      "Bash(.venv/Scripts/ruff format *)",
      "PowerShell(.venv\\Scripts\\python tools\\check.py *)",
      "PowerShell(.venv\\Scripts\\python tools\\screenshots.py *)",
      "PowerShell(.venv\\Scripts\\python -m pytest *)",
      "Bash(npm --prefix website run build *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(python tools/maintainer.py whoami*)",
      "Bash(python tools/maintainer.py inbox*)",
      "Bash(python tools/maintainer.py audit *)",
      "Bash(python tools/maintainer.py diff *)",
      "Bash(.venv/Scripts/python tools/maintainer.py whoami*)",
      "Bash(.venv/Scripts/python tools/maintainer.py inbox*)",
      "Bash(.venv/Scripts/python tools/maintainer.py audit *)",
      "Bash(.venv/Scripts/python tools/maintainer.py diff *)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(gh pr close *)",
      "Bash(gh issue close *)",
      "Bash(gh issue delete *)",
      "Bash(gh release *)",
      "Bash(gh workflow run *)",
      "Bash(gh workflow enable *)",
      "Bash(gh workflow disable *)",
      "Bash(gh run rerun *)",
      "Bash(gh run cancel *)",
      "Bash(gh api *--method*)",
      "Bash(gh api *-X*)",
      "Bash(gh api *--input*)",
      "Bash(gh api *-f *)",
      "Bash(gh api *-F *)",
      "Bash(gh api *--field*)",
      "Bash(gh api *--raw-field*)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh pr review *)",
      "PowerShell(gh pr close *)",
      "PowerShell(gh issue close *)",
      "PowerShell(gh issue delete *)",
      "PowerShell(gh release *)",
      "PowerShell(gh workflow run *)",
      "PowerShell(gh run rerun *)",
      "PowerShell(gh api *--method*)",
      "PowerShell(gh api *-X*)",
      "PowerShell(gh api *--input*)",
      "PowerShell(gh api *-f *)",
      "PowerShell(gh api *-F *)",
      "PowerShell(gh api *--field*)",
      "PowerShell(gh api *--raw-field*)",
      "Edit(/tests/test_guardrails.py)",
      "Edit(/.github/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/LICENSE)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/AppData/Roaming/DJToolkit/token.json)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh auth token*)",
      "PowerShell(gh secret *)",
      "PowerShell(gh variable *)",
      "PowerShell(gh repo edit *)",
      "PowerShell(gh repo delete *)",
      "PowerShell(gh auth token*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks/run.sh\" after-edit",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/hooks/run.sh\" stop-gate",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
